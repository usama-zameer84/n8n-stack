# Public hostname that n8n will be served at via the Cloudflare Tunnel.
DOMAIN=n8n.example.com

# Cloudflare account + API token with Tunnel:Edit (account) + DNS:Edit (zone).
# Create at dash.cloudflare.com -> My Profile -> API Tokens -> Create Token -> Custom.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TUNNEL_NAME=n8n-tunnel

# TZ identifier (e.g. America/New_York, Europe/London). Used by n8n for cron.
TIMEZONE=UTC

# ---- Secrets (generated by scripts/init-env.sh) ----
# DO NOT change N8N_ENCRYPTION_KEY after first run: it encrypts stored
# credentials. Losing it makes all existing credentials unrecoverable.
N8N_ENCRYPTION_KEY=
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n_app
POSTGRES_NON_ROOT_PASSWORD=

# ---- Separate database for workflow data (Postgres node credentials) ----
# Isolated from n8n's internal DB so workflow queries can't touch n8n's
# executions/users tables. Use these in the n8n Postgres credential:
#   Host: postgres  Port: 5432  Database: ${WORKFLOW_DB}
#   User: ${WORKFLOW_DB_USER}  Password: ${WORKFLOW_DB_PASSWORD}
WORKFLOW_DB=workflows
WORKFLOW_DB_USER=workflow_app
WORKFLOW_DB_PASSWORD=

# ---- Optional basic-auth (front-end login gate) ----
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ---- MCP access (users connect MCP clients to their n8n account) ----
# Instance-level MCP server endpoint: https://${DOMAIN}/mcp-server/http
# Auth: per-user access token (Settings > Instance-level MCP > Access Token).
# MANAGED_BY_ENV=true locks the on/off toggle in the UI; token + workflow
# enablement remain UI-driven.
N8N_MCP_ACCESS_ENABLED=true
N8N_MCP_MANAGED_BY_ENV=true

# ---- Task runner auth (n8n + sidecar pair) ----
# Random token shared between n8n (broker) and the task-runners sidecar so
# only your runner container can connect. Generate with:
#   openssl rand -hex 32
RUNNER_TOKEN=

# ---- Backup retention ----
# Rolling-N: each successful backup deletes the oldest N snapshot sets
# (n8n.sql.gz + workflows.sql.gz + n8n-data.tar.gz pruned as one unit,
# keyed on the timestamp). One set ~= 150MB compressed, so disk usage
# stays bounded regardless of how long the stack runs.
#
# Tradeoff: with N=1, a backup that's *partially* written (e.g. only one
# of the three files landed) could let the next successful prune delete
# the last *complete* set. The cron sidecar is gated by set -eu + a
# temp-file trap so most failures abort cleanly, but if you want
# belt-and-suspenders keep N >= 2.
BACKUP_KEEP=2

# 5-field cron, evaluated inside the n8n-backup sidecar by busybox crond.
# Default: top of every hour.
BACKUP_SCHEDULE=0 * * * *

# Set to "true" to run one backup immediately on container start.
# Default false: on a 1GB box, an immediate full dump + tar right after
# `docker compose up` is what tips the VM into OOM. Leave it off; the
# first cron tick (top of the next hour) produces the first snapshot.
BACKUP_ON_START=false
